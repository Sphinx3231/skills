# Auth is handled by Clerk (email/password + Google/Facebook/etc.) — create a
# free app at https://dashboard.clerk.com, then copy these from API Keys.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

PORT=4000
ANTHROPIC_API_KEY=sk-ant-...

# Optional: only needed to enable the paid subscription flow after the free
# 30-day trial. Without these, trial tracking still works, but
# /billing/create-checkout-session returns 501 and users can't be charged.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
