# Auth is handled by Clerk (email/password + Google/Facebook/etc.) — create a
# free app at https://dashboard.clerk.com, then copy these from API Keys.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

PORT=4000
# Only needed for /food/analyze-text (voice/typed description) — photo scans
# (/food/analyze) run a local CLIP model with no API key needed (ticket 010).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: overrides where the local CLIP model's weights are cached.
# Defaults to LOCALAPPDATA/foxbite/hf-cache (Windows) or
# XDG_CACHE_HOME/foxbite/hf-cache — deliberately outside node_modules
# (survives `npm ci`) and outside this repo's working tree.
# FOXBITE_HF_CACHE_DIR=

# Optional: only needed to enable the paid subscription flow after the free
# 30-day trial. Without these, trial tracking still works, but
# /billing/create-checkout-session returns 501 and users can't be charged.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PRICE_ID=price_...
STRIPE_WEBHOOK_SECRET=whsec_...
